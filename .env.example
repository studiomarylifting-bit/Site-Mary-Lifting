# Copie para .env.local. NUNCA commite o arquivo real.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
# Chave anon/publishable (pública por desenho, protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOMENTE servidor. Usada para: rate limit, inserts anônimos de SAC/feedback,
# fila de notificações. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Uazapi (notificação administrativa ao WhatsApp do Studio) ---
# Base URL da sua instância, ex.: https://SEUSUBDOMINIO.uazapi.com
UAZAPI_BASE_URL=
# Token da INSTÂNCIA (header "token"). Não é o admintoken.
UAZAPI_TOKEN=
# Número do Studio, formato internacional sem "+": 5511999999999
UAZAPI_STUDIO_PHONE=

# --- Google Places API (New) ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- Anti-abuso ---
# Sal para pseudonimizar IPs no rate limit (string aleatória longa)
RATE_LIMIT_SALT=

# --- Dados legais exibidos na /privacidade e /termos (públicos por natureza) ---
# Deixe vazio até o Studio definir: a página mostra "a definir" em vez de inventar.
NEXT_PUBLIC_LEGAL_CONTROLLER_NAME=
# CNPJ ou CPF do controlador
NEXT_PUBLIC_LEGAL_CONTROLLER_DOCUMENT=
NEXT_PUBLIC_LEGAL_PRIVACY_EMAIL=
NEXT_PUBLIC_LEGAL_DPO_NAME=
# Prazo de retenção da ficha, ex.: "5 anos após o último atendimento" (definir com orientação jurídica)
NEXT_PUBLIC_LEGAL_RETENTION_INTAKE=
